#!/usr/bin/make -f
# -*- makefile -*-

# Go module build
export GOPROXY = https://proxy.golang.org
export GOSUMDB = sum.golang.org
export GO111MODULE = on
export CGO_ENABLED = 0

DEST = $$(pwd)/debian/@NAME@

# For chroot builds without $HOME
ifeq ($(HOME),/nonexistent)
export HOME = /build
endif

%:
	dh $@

override_dh_auto_build:
	GOTOOLCHAIN=auto go build -ldflags="-s -w -X main.version=v@VERSION@" -o kaclaig ./cmd/kaclaig

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	GOTOOLCHAIN=auto go test ./...
endif

override_dh_auto_install:
	mkdir -p $(DEST)/usr/bin
	mkdir -p $(DEST)/usr/share/man/man1
	install -m 755 kaclaig $(DEST)/usr/bin/kaclaig
	install -m 644 man/kaclaig.1 $(DEST)/usr/share/man/man1/kaclaig.1
