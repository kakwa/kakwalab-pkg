#!/bin/sh
set -e

case "$1" in
    install)
        if ! getent passwd whim > /dev/null ; then
            adduser --system --group --quiet --home /var/lib/whim \
              --no-create-home --disabled-login whim
        fi
    ;;
    upgrade)
    ;;
    abort-upgrade)
    ;;
    *)
        echo "preinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
